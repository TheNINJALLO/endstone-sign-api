{
  "schema": 2,
  "project": "endstone-sign-api",
  "api": "0.2.1",
  "service": "endstone:sign:v2",
  "service_abi": 2,
  "adapters": [
    {
      "family": "26.30",
      "runtime_bds": "26.33",
      "official_package": "1.26.33.1",
      "endstone": "0.11.6",
      "status": "stable",
      "portable_contract": "complete",
      "native_service_registration": true,
      "supported_native_service_registration": true,
      "verified_native_service_registration": true,
      "complete_control": true,
      "supported_capabilities": [
        "capture",
        "place",
        "remove",
        "replace",
        "clone",
        "move",
        "atomic_transactions",
        "front_and_back_text",
        "per_line_write",
        "text_objects",
        "filtered_text",
        "owner_xuid",
        "text_color",
        "glowing",
        "hide_glow_outline",
        "persist_formatting",
        "waxed",
        "editor_lock",
        "open_editor",
        "player_edit_events",
        "api_edit_events",
        "client_updates",
        "restart_persistence"
      ],
      "known_unavailable_capabilities": [],
      "runtime_requirements": [
        "exact executable SHA-256",
        "exact BDS 1.26.33.1 on Linux x64",
        "Endstone 0.11.6",
        "required SignBlockActor symbol and ABI fingerprints"
      ]
    }
  ],
  "policy": "v0.2.1 is the production Linux x64 release for the exact BDS 1.26.33.1 executable and Endstone 0.11.6; runtime identity, native fingerprints, revisions, readback, and rollback remain mandatory"
}
