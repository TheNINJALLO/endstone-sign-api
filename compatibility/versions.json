{
  "schema": 2,
  "project": "endstone-sign-api",
  "api": "0.2.1-alpha.1",
  "service": "endstone:sign:v2",
  "service_abi": 2,
  "adapters": [
    {
      "family": "26.30",
      "runtime_bds": "26.33",
      "official_package": "1.26.33.1",
      "endstone": "0.11.6",
      "status": "linux-full-system-qualification-candidate",
      "portable_contract": "complete",
      "native_service_registration": true,
      "supported_native_service_registration": true,
      "verified_native_service_registration": false,
      "complete_control": false,
      "supported_capabilities": [
        "capture",
        "place",
        "remove",
        "replace",
        "clone",
        "move",
        "atomic_transactions",
        "front_and_back_text",
        "per_line_write",
        "text_objects",
        "filtered_text",
        "owner_xuid",
        "text_color",
        "glowing",
        "hide_glow_outline",
        "persist_formatting",
        "waxed",
        "editor_lock",
        "open_editor",
        "player_edit_events",
        "api_edit_events",
        "client_updates",
        "restart_persistence"
      ],
      "known_unavailable_capabilities": [
        "complete_control"
      ],
      "runtime_requirements": [
        "exact executable SHA-256",
        "exact BDS 1.26.33.1 on Linux x64",
        "Endstone 0.11.6",
        "required SignBlockActor symbol and ABI fingerprints"
      ]
    }
  ],
  "policy": "v0.2.1-alpha.1 exposes every exact-Linux native capability so one strict full-system run can qualify them together; completeControl() remains false until stage evidence is activated"
}
